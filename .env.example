# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Jakarta

# ─── Database utama (MySQL) ─────────────────────────────────────────────────
# Dev lokal (docker compose up -d):
DATABASE_URL="mysql://avicenna:avicenna@127.0.0.1:3306/avicenna"
# Produksi on-prem: isi di .env (tidak ikut ter-commit), bukan di file ini.
# DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>"

# ─── Valkey (queue, cache, pub/sub realtime) ────────────────────────────────
# Valkey = fork Redis berlisensi BSD. Protokolnya identik, jadi skema URL
# tetap "redis://" dan nama variabelnya tetap REDIS_URL — itu yang dikenali
# ioredis dan BullMQ. Redis asli juga tetap bisa dipakai tanpa ubahan.
REDIS_URL="redis://127.0.0.1:6379"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Ganti sebelum deploy: openssl rand -base64 48
JWT_SECRET="ubah-nilai-ini-sebelum-deploy"
JWT_EXPIRES_IN="8h"
DEVICE_JWT_EXPIRES_IN="365d"

# ─── SQL Server J922 (data mesin, READ-ONLY) ────────────────────────────────
# Dipakai worker sync saja. Web app tidak pernah konek langsung ke sini.
#
# Nilai sebenarnya (host, instance, kredensial) ada di .env masing-masing
# lingkungan dan TIDAK ditulis di sini — file ini ikut ter-commit, dan alamat
# jaringan internal pabrik tidak perlu ada di dalam repo.
# Sumbernya bisa dilihat di .env sistem lama (avicenna & bella).
MSSQL_HOST=""
MSSQL_PORT=1433
MSSQL_INSTANCE=""
MSSQL_DATABASE=""
MSSQL_USER=""
MSSQL_PASSWORD=""
MSSQL_SYNC_ENABLED=false

# ─── MQTT (event mesin) ─────────────────────────────────────────────────────
MQTT_URL="mqtt://127.0.0.1:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC_PREFIX="aiia/+/machine"
MQTT_ENABLED=false

# ─── Service URLs ───────────────────────────────────────────────────────────
API_PORT=3001
API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"
WEB_PORT=3000

# ── Dorong ke SAP lewat MS SQL ───────────────────────────────────────────────
#
# SENGAJA TERPISAH dari MSSQL_* di atas. Yang itu menunjuk J922 dengan user
# baca-saja untuk MENARIK data mesin; yang ini tujuan tulis untuk SAP. Memakai
# satu set kredensial untuk dua arah berarti memberi hak tulis pada koneksi
# yang seharusnya hanya membaca — hak yang tidak akan dicabut lagi setelah
# terlanjur diberikan.
#
# Biarkan false sampai bentuk tabel tujuan DAN movement type disepakati tim
# SAP. Selama false, dokumen tetap dikumpulkan dan menunggu; tidak ada yang
# hilang, dan tunggakannya terlihat di layar /sap.
SAP_MSSQL_ENABLED=false
SAP_MSSQL_HOST=""
SAP_MSSQL_PORT=1433
SAP_MSSQL_INSTANCE=""
SAP_MSSQL_DATABASE=""
SAP_MSSQL_USER=""
SAP_MSSQL_PASSWORD=""
