# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Jakarta

# ─── Database utama (MySQL) ─────────────────────────────────────────────────
# Dev lokal (docker compose up -d):
DATABASE_URL="mysql://avicenna:avicenna@127.0.0.1:3306/avicenna"
# Produksi on-prem: isi di .env (tidak ikut ter-commit), bukan di file ini.
# DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>"

# ─── Valkey (queue, cache, pub/sub realtime) ────────────────────────────────
# Valkey = fork Redis berlisensi BSD. Protokolnya identik, jadi skema URL
# tetap "redis://" dan nama variabelnya tetap REDIS_URL — itu yang dikenali
# ioredis dan BullMQ. Redis asli juga tetap bisa dipakai tanpa ubahan.
REDIS_URL="redis://127.0.0.1:6379"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Ganti sebelum deploy: openssl rand -base64 48
JWT_SECRET="ubah-nilai-ini-sebelum-deploy"
JWT_EXPIRES_IN="8h"
DEVICE_JWT_EXPIRES_IN="365d"

# ─── SQL Server J922 (data mesin, READ-ONLY) ────────────────────────────────
# Dipakai worker sync saja. Web app tidak pernah konek langsung ke sini.
#
# Nilai sebenarnya (host, instance, kredensial) ada di .env masing-masing
# lingkungan dan TIDAK ditulis di sini — file ini ikut ter-commit, dan alamat
# jaringan internal pabrik tidak perlu ada di dalam repo.
# Sumbernya bisa dilihat di .env sistem lama (avicenna & bella).
MSSQL_HOST=""
MSSQL_PORT=1433
MSSQL_INSTANCE=""
MSSQL_DATABASE=""
MSSQL_USER=""
MSSQL_PASSWORD=""
MSSQL_SYNC_ENABLED=false

# ─── MQTT (event mesin) ─────────────────────────────────────────────────────
MQTT_URL="mqtt://127.0.0.1:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC_PREFIX="aiia/+/machine"
MQTT_ENABLED=false

# ─── Service URLs ───────────────────────────────────────────────────────────
API_PORT=3001
API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"
WEB_PORT=3000

# ─── Database jembatan (staging) SAP ────────────────────────────────────────
#
# Avicenna tidak pernah bicara langsung dengan SAP. Di antara keduanya ada satu
# database MS SQL — "staging" — dan lalu lintasnya dua arah:
#
#   Avicenna  --dorong transaksi-->  STAGING  --ditarik-->  SAP
#   Avicenna  <--tarik master------  STAGING  <--didorong-- SAP
#
# SAP menulis balik flag berhasil/gagal di baris yang sama, dan flag itulah yang
# menutup dokumen di TT_SAP_OUTBOX. Kita punya akses penuh baca-tulis ke staging.
#
# SENGAJA TERPISAH dari MSSQL_* di atas. Yang itu menunjuk J922 dengan user
# baca-saja untuk MENARIK data mesin; yang ini database lain dengan user yang
# boleh menulis. Memakai satu set kredensial untuk dua arah berarti memberi hak
# tulis pada koneksi yang seharusnya hanya membaca — hak yang tidak akan dicabut
# lagi setelah terlanjur diberikan.
#
# Nilai sebenarnya diisi di .env masing-masing lingkungan, TIDAK di file ini:
# file ini ikut ter-commit, dan alamat jaringan internal pabrik tidak perlu ada
# di dalam repo.
STAGING_HOST=""
STAGING_PORT=1433
# Named instance (mis. "SQLEXPRESS"). Kalau diisi, KOSONGKAN STAGING_PORT —
# tedious menanyakan portnya ke SQL Browser, dan mengisi keduanya membuat port
# tetap yang salah dipakai. Gejalanya timeout tanpa pesan yang menjelaskan apa pun.
STAGING_INSTANCE=""
STAGING_DATABASE=""
STAGING_USER=""
STAGING_PASSWORD=""

# Bawaan untuk SQL Server on-prem di jaringan pabrik. WAJIB diubah bila
# databasenya ada di luar jaringan pabrik.
STAGING_ENCRYPT=false
STAGING_TRUST_CERT=true

# ── Dua saklar, bukan satu ───────────────────────────────────────────────────
#
# Arah dorong bisa dinyalakan lebih dulu tanpa ikut menyalakan tarik data.
# TARIK menyinkronkan master dan loading list hari pengiriman aktif. Kepala/item
# pengiriman dimiliki SAP; hasil scan operasional di MES tidak ditimpa.
#
# Selama dorong masih false, dokumen tetap dikumpulkan dan menunggu di outbox;
# tidak ada yang hilang, dan tunggakannya terlihat di layar /sap.
STAGING_PUSH_ENABLED=false
STAGING_PULL_ENABLED=false

# ── Nama tabel & kolom di staging ────────────────────────────────────────────
#
# Strukturnya sudah ada di sisi tim SAP, tetapi belum dicocokkan dengan repo ini.
# Bawaan di apps/api/src/staging/staging-tables.ts masih DUGAAN.
#
# Untuk melihat struktur yang sebenarnya, tanpa menunggu dokumen dari tim SAP:
#
#     pnpm staging:introspect                  # daftar seluruh tabel
#     pnpm staging:introspect NAMA_TABEL       # kolom & indeksnya
#
# lalu isi yang berikut ini. Selama belum cocok, pendorongan MENOLAK berjalan —
# menulis ke kolom yang salah nama hanya menghasilkan ratusan dokumen FAILED yang
# terlihat seperti masalah data, padahal masalah konfigurasi.
# STAGING_TABLE_MOVEMENT="MES_STOCK_MOVEMENT"
# STAGING_COL_IDEMPOTENCY="IDEMPOTENCY_KEY"
# STAGING_COL_DOC_TYPE="DOC_TYPE"
# STAGING_COL_MOVEMENT_TYPE="MOVEMENT_TYPE"
# STAGING_COL_PLANT="PLANT_CODE"
# STAGING_COL_PART="PART_NUMBER"
# STAGING_COL_QTY="QTY"
# STAGING_COL_UOM="UOM"
# STAGING_COL_SLOC_FROM="SLOC_FROM"
# STAGING_COL_SLOC_TO="SLOC_TO"
# STAGING_COL_LOT="LOT_NUMBER"
# STAGING_COL_OCCURRED_AT="OCCURRED_AT"
# STAGING_COL_SOURCE_SYSTEM="SOURCE_SYSTEM"
# STAGING_COL_SOURCE_TABLE="SOURCE_TABLE"
# STAGING_COL_SOURCE_ID="SOURCE_ID"
# STAGING_COL_CREATED_AT="CREATED_AT"
#
# Kolom yang DIISI SAP, dibaca balik untuk menutup dokumen:
# STAGING_COL_STATUS="PROCESS_STATUS"
# STAGING_COL_SAP_DOC="SAP_DOC_NUMBER"
# STAGING_COL_ERROR="ERROR_MESSAGE"
# STAGING_COL_PROCESSED_AT="PROCESSED_AT"
#
# Nilai flag — HARUS persis sama dengan yang dipakai program di sisi SAP. Kalau
# beda, dokumen yang sebenarnya sudah diproses akan terlihat menggantung
# selamanya di layar pemantauan, dan tidak akan ada yang menyadarinya.
# STAGING_FLAG_NEW="N"
# STAGING_FLAG_OK="S"
# STAGING_FLAG_ERROR="E"
