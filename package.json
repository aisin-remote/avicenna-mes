{
  "name": "avicenna",
  "private": true,
  "version": "0.1.0",
  "description": "Avicenna MES - unified manufacturing execution system (rebuild of avicenna + bella)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @avicenna/db db:generate",
    "db:migrate": "pnpm --filter @avicenna/db db:migrate",
    "db:push": "pnpm --filter @avicenna/db db:push",
    "db:studio": "pnpm --filter @avicenna/db db:studio",
    "db:seed": "pnpm --filter @avicenna/db db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "staging:introspect": "pnpm --filter @avicenna/api staging:introspect",
    "staging:compare": "pnpm --filter @avicenna/api staging:compare",
    "deploy:data": "docker compose -f docker/compose.data.yml up -d",
    "deploy:app": "docker compose -f docker/compose.app.yml up -d --build",
    "deploy:seed": "docker compose -f docker/compose.app.yml --profile tools run --rm seed",
    "deploy:logs": "docker compose -f docker/compose.app.yml logs -f --tail=100",
    "deploy:ps": "docker compose -f docker/compose.data.yml ps && docker compose -f docker/compose.app.yml ps",
    "db:import-aiia": "pnpm --filter @avicenna/db db:import-aiia",
    "db:check": "pnpm --filter @avicenna/db db:check"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "prettier": "3.4.2",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
