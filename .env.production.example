# ─────────────────────────────────────────────────────────────────────────────
# Contoh .env untuk server. Salin menjadi .env DI SERVER, lalu isi.
#
#   cp .env.production.example .env
#
# Berkas .env TIDAK ikut ke dalam image (lihat .dockerignore) dan tidak boleh
# di-commit. Compose membacanya saat menjalankan wadah.
# ─────────────────────────────────────────────────────────────────────────────

TZ=Asia/Jakarta

# ── Database ────────────────────────────────────────────────────────────────
# Dipakai tumpukan data (membuat database) DAN tumpukan aplikasi (menyambung).
MYSQL_ROOT_PASSWORD=ganti-ini
MYSQL_DATABASE=avicenna
MYSQL_USER=avicenna
MYSQL_PASSWORD=ganti-ini
# Port di host. Hanya terbuka ke 127.0.0.1 server.
MYSQL_PORT=3306
REDIS_PORT=6379
# Buffer pool InnoDB. Bawaan 128M; naikkan ke sekitar setengah RAM server
# (mis. 4G pada server 8 GB) sebelum tabel scan tumbuh besar.
MYSQL_BUFFER_POOL=128M

# ── Rahasia ─────────────────────────────────────────────────────────────────
#
# WAJIB diganti. Bangkitkan yang baru dan panjang:
#
#     openssl rand -base64 48
#
# Token login ditandatangani dengan ini. Memakai nilai yang sama dengan
# lingkungan lain berarti token dari laptop pengembang berlaku di produksi.
JWT_SECRET=
JWT_EXPIRES_IN=8h
DEVICE_JWT_EXPIRES_IN=365d

# ── Port aplikasi ───────────────────────────────────────────────────────────
# API tidak dibuka ke jaringan; hanya web yang menghadap keluar.
API_PORT=3001
WEB_PORT=3000
# 127.0.0.1 karena ada nginx di depannya (lihat docker/nginx/avicenna.conf.example).
#
# Dengan 0.0.0.0, port 3000 yang polos tetap terbuka ke seluruh jaringan pabrik
# di samping yang https — dan TLS-nya bisa dilewati begitu saja dengan mengetik
# http://<server>:3000, lengkap dengan kartu login NPK|sandi yang lewat sebagai
# teks biasa. Pakai 0.0.0.0 HANYA kalau memang belum ada reverse proxy.
WEB_BIND=127.0.0.1
# URL publik API untuk browser (aliran SSE monitor). Dibaca komponen Server
# per-request lalu diteruskan sebagai prop ke klien. Isi dengan alamat https
# yang sama dengan yang dibuka ke jaringan pabrik.
NEXT_PUBLIC_API_URL=https://avicenna-next.aiia.co.id

# ── MQTT ────────────────────────────────────────────────────────────────────
MQTT_ENABLED=false
MQTT_URL=mqtt://mosquitto:1883
MQTT_TOPIC_PREFIX=avicenna
MQTT_PORT=1883
MQTT_BIND=127.0.0.1

# ── Jembatan staging SAP (SQL Server, DI LUAR Docker) ───────────────────────
#
# Biarkan false sampai kredensialnya benar dan tim SAP sudah mengonfirmasi
# movement type. Menyala tanpa itu hanya memenuhi log dengan galat koneksi,
# dan galat yang sungguhan jadi tenggelam.
SAP_MSSQL_ENABLED=false
STAGING_HOST=
STAGING_PORT=1433
STAGING_INSTANCE=
STAGING_DATABASE=
STAGING_USER=
STAGING_PASSWORD=

# Sinkronisasi mesin dari SQL Server J922 — masih kerangka, biarkan false.
MSSQL_SYNC_ENABLED=false
