              }
            }
          ]
        },
        {
          "name": "Status Delivery Order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/loading/{{deliveryId}}/delivery-order",
            "description": "{data,flow?,reason?}; data null sebelum DO tersedia. Koleksi tidak menjalankan Finish Pulling."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for (const key of [\"baseUrl\",\"accessToken\",\"deliveryId\"]) {",
                  "  const value = pm.variables.get(key);",
                  "  if (value === undefined || String(value).trim() === '') throw new Error('Isi variabel koleksi: ' + key);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
